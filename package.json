{
  "name": "slipkit",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "remix vite:build",
    "dev": "shopify app dev",
    "generate": "shopify app generate",
    "deploy": "shopify app deploy",
    "config:link": "shopify app config link",
    "config:use": "shopify app config use",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "setup": "prisma generate && prisma migrate deploy",
    "docker-start": "npm run setup && npm run start",
    "start": "remix-serve ./build/server/index.js",
    "postinstall": "prisma generate",
    "prisma:studio": "prisma studio"
  },
  "type": "module",
  "engines": {
    "node": ">=18.20.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "^5.19.1",
    "@react-pdf/renderer": "^3.4.4",
    "@remix-run/node": "2.16.7",
    "@remix-run/react": "2.16.7",
    "@remix-run/serve": "2.16.7",
    "@shopify/app-bridge-react": "^4.1.6",
    "@shopify/polaris": "^13.0.0",
    "@shopify/polaris-icons": "^9.0.0",
    "@shopify/shopify-app-remix": "^3.2.0",
    "@shopify/shopify-app-session-storage-prisma": "^5.0.5",
    "isbot": "^4.4.0",
    "prisma": "^5.19.1",
    "react": "^18.2.0",
    "react-colorful": "^5.6.1",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@remix-run/dev": "2.16.7",
    "@shopify/api-codegen-preset": "^2.0.1",
    "@shopify/cli": "^4.6.0",
    "@vercel/remix": "2.16.7",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "vite": "^5.4.2",
    "vite-tsconfig-paths": "^4.3.2"
  }
}
